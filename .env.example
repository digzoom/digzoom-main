# DigZoom environment variables
# Copy to .env and use values from the deployment secret manager.

# Public Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Server only. Never prefix this with VITE_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Checkout stays disabled until a verified payment webhook is live.
VITE_CHECKOUT_ENABLED=false
CHECKOUT_ENABLED=false

# Stripe server configuration. Never prefix these values with VITE_.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
SITE_URL=https://digzoom.com

# Paid-order alerts. Resend needs a verified sending domain.
RESEND_API_KEY=YOUR_SERVER_ONLY_RESEND_KEY
ORDER_FROM_EMAIL=DigZoom <contact@digzoom.com>
ORDER_TO_EMAIL=info@digzoom.com

# Optional WhatsApp Business Cloud API alerts to the store owner.
# Create/approve a utility template with three body placeholders:
# {{1}} order number, {{2}} amount, {{3}} products.
WHATSAPP_ACCESS_TOKEN=YOUR_SERVER_ONLY_META_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_META_BUSINESS_PHONE_ID
ORDER_WHATSAPP_TO=9665XXXXXXXX
ORDER_WHATSAPP_TEMPLATE=digzoom_paid_order
ORDER_WHATSAPP_LANGUAGE=ar

# Optional integrations
APP_ID=YOUR_APP_ID
APP_SECRET=YOUR_SERVER_ONLY_APP_SECRET
VITE_APP_ID=YOUR_PUBLIC_APP_ID
VITE_KIMI_AUTH_URL=https://auth.kimi.com
KIMI_AUTH_URL=https://auth.kimi.com
KIMI_OPEN_URL=https://open.kimi.com
OWNER_UNION_ID=YOUR_OWNER_UNION_ID
VITE_GA4_ID=YOUR_GA4_ID
DATABASE_URL=YOUR_SERVER_ONLY_DATABASE_URL

# DigZoom environment variables
# Copy to .env and use values from the deployment secret manager.

# Public Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Server only. Never prefix this with VITE_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Checkout stays disabled until a verified payment webhook is live.
VITE_CHECKOUT_ENABLED=false
CHECKOUT_ENABLED=false

# Optional integrations
APP_ID=YOUR_APP_ID
APP_SECRET=YOUR_SERVER_ONLY_APP_SECRET
VITE_APP_ID=YOUR_PUBLIC_APP_ID
VITE_KIMI_AUTH_URL=https://auth.kimi.com
KIMI_AUTH_URL=https://auth.kimi.com
KIMI_OPEN_URL=https://open.kimi.com
OWNER_UNION_ID=YOUR_OWNER_UNION_ID
VITE_GA4_ID=YOUR_GA4_ID
DATABASE_URL=YOUR_SERVER_ONLY_DATABASE_URL
